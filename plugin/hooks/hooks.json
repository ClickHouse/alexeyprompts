{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/upload_sessions.sh", "async": true }
        ]
      }
    ],
    "SessionEnd": [
      {
